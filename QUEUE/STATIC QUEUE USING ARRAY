
#include <stdio.h>

int queue[5];
int front = -1, rear = -1;

void insert(int value)
{
    if (rear == 4)
        printf("Queue is Full");
    else
    {
        if (front == -1)
            front = 0;

        rear++;
        queue[rear] = value;
    }
}

void delete()
{
    if (front == -1)
        printf("Queue is Empty");
    else
    {
        printf("Deleted: %d", queue[front]);

        if (front == rear)
            front = rear = -1;
        else
            front++;
    }
}

void display()
{
    int index;

    if (front == -1)
        printf("Queue is Empty");
    else
    {
        for (index = front; index <= rear; index++)
            printf("%d ", queue[index]);
    }
}

int main()
{
    insert(10);
    insert(20);
    insert(30);

    display();
    delete();

    return 0;
}

