#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> v = {10, 25, 5, 40, 15};

    cout << "Original array: ";
    for(int i = 0; i < v.size(); i++) {
        cout << v[i] << " ";
    }

    v.push_back(50);

    cout << "\nAfter push_back: ";
    for(int i = 0; i < v.size(); i++) {
        cout << v[i] << " ";
    }

    v.pop_back();

    cout << "\nAfter pop_back: ";
    for(int i = 0; i < v.size(); i++) {
        cout << v[i] << " ";
    }

    return 0;
}
