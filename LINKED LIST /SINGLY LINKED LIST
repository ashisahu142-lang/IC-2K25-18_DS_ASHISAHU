#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

int main() {
    Node *a = new Node{10, NULL};
    Node *b = new Node{20, NULL};
    Node *c = new Node{30, NULL};

    a->next = b;
    b->next = c;

    Node* t = a;

    while (t != NULL) {
        cout << t->data << " ";
        t = t->next;
    }

    return 0;
}
