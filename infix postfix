#include <iostream>
#include <stack>
using namespace std;

int main()
{
    string infix, postfix = "";
    stack<char> s;

    cout << "Enter infix: ";
    cin >> infix;

    for (char ch : infix)
    {
        if (ch >= 'A' && ch <= 'Z')
        {
            postfix += ch;
        }
        else if (ch == '(')
        {
            s.push(ch);
        }
        else if (ch == ')')
        {
            while (s.top() != '(')
            {
                postfix += s.top();
                s.pop();
            }
            s.pop();
        }
        else
        {
            while (!s.empty() && s.top() != '(')
            {
                postfix += s.top();
                s.pop();
            }
            s.push(ch);
        }
    }

    while (!s.empty())
    {
        postfix += s.top();
        s.pop();
    }

    cout << "Postfix: " << postfix;

    return 0;
}